# moat-journal 환경변수 템플릿
# 이 파일을 복사해 automation/.env 로 저장하고 값을 채운 뒤,
# cron wrapper 또는 `source automation/.env` 로 로드한다.
# 실제 .env (시크릿) 는 절대 커밋하지 않는다.

# --- Claude Code OAuth (LaunchAgent wrapper 에서 Keychain 주입) ---
# 로컬 수동 실행 시에만 직접 설정. wrapper 는 Keychain 에서 자동 주입한다.
CLAUDE_CODE_OAUTH_TOKEN=

# --- 텔레그램: 주식 moat 트랙 (target="moat", 기본) ---
MOAT_TELEGRAM_BOT_TOKEN=
MOAT_TELEGRAM_CHAT_ID=

# --- 텔레그램: 지수/ETF index 트랙 (target="index") ---
# BOT_TOKEN 미설정 시 MOAT_TELEGRAM_BOT_TOKEN 으로 폴백한다(같은 봇, 다른 채팅).
# CHAT_ID 는 반드시 별도 설정해야 index 채널로 분리 전송된다(미설정 시 RuntimeError).
MOAT_INDEX_TELEGRAM_BOT_TOKEN=
MOAT_INDEX_TELEGRAM_CHAT_ID=

# --- 텔레그램: 트리거 경보 (target="alert") ---
# 낙폭 등 임계 돌파 시에만 울리는 전용 채널. 지수·개별주 모든 트리거가 여기로 모인다.
# 전용 봇: @drop_trigger_alert_bot
MOAT_ALERT_TELEGRAM_BOT_TOKEN=
MOAT_ALERT_TELEGRAM_CHAT_ID=
